# ---------------------------------------------------------------------------
# AI Policy Tracker - example environment. Copy to .env and fill in real values.
# Never commit .env. All values below are placeholders.
# ---------------------------------------------------------------------------

APP_NAME="AI Policy Tracker"
APP_ENV=local
APP_KEY=                      # generate with: php artisan key:generate
APP_DEBUG=true                # MUST be false in production
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # use "error" or "warning" in production

# --- Database ---------------------------------------------------------------
# Local quick start (SQLite):
DB_CONNECTION=sqlite
# Supabase / PostgreSQL (recommended for staging & production):
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-<region>.pooler.supabase.com   # Supabase "Session pooler" host (IPv4-friendly)
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=your-database-password
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # true in production (HTTPS only)
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database     # run "php artisan queue:work" for e-mail notifications
CACHE_STORE=database
CACHE_PREFIX=

# --- Mail (verification e-mails and bookmark notifications) -----------------
MAIL_MAILER=log               # production: resend (set RESEND_KEY) or smtp / ses / postmark
RESEND_KEY=                   # from https://resend.com/api-keys; sending domain must be verified in Resend
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Application ------------------------------------------------------------
# Comma-separated e-mail addresses allowed into the /backend admin area.
ADMIN_EMAILS=admin@example.com
# Used once by "php artisan db:seed" to create the first admin account.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional public links (leave blank to hide the menu/footer item).
SITE_LINK_AIRIS=
SITE_LINK_WHITEPAPER=
SITE_LINK_PRIVACY_POLICY=
SITE_LINK_TERMS_OF_USE=
# Comma-separated contact addresses shown on the About page.
CONTACT_EMAILS=contact@example.com

# Optional Google Analytics 4 measurement ID (blank disables tracking).
GOOGLE_ANALYTICS_ID=
# Shared secret for the weekly digest trigger (or set it from the admin Settings page).
CRON_TOKEN=
# Upper bound for client-supplied page sizes on JSON endpoints.
MAX_PER_PAGE=100
# Comma-separated origins allowed for CORS (blank = none).
CORS_ALLOWED_ORIGINS=

VITE_APP_NAME="${APP_NAME}"

# --- Public site, SEO and analytics (all optional) ---------------------------
SITE_NAME="AIPolicyTracker"
SITE_GITHUB_URL=https://github.com/8h45k4r/aipolicytracker
SITE_CERTIFYI_URL=https://certifyi.ai
SITE_NEWSLETTER_URL=
SITE_SOCIAL_PROFILES=
SITE_OG_IMAGE=/og-default.png
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
CLOUDFLARE_ANALYTICS_TOKEN=
ANALYTICS_REQUIRE_CONSENT=true
