# ---------------------------------------------------------------------------
# AI Policy Tracker - example environment. Copy to .env and fill in real values.
# Never commit .env. All values below are placeholders.
# ---------------------------------------------------------------------------

APP_NAME="AI Policy Tracker"
APP_ENV=local
APP_KEY=                      # generate with: php artisan key:generate
APP_DEBUG=true                # MUST be false in production
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # use "error" or "warning" in production

# --- Database ---------------------------------------------------------------
# Local quick start (SQLite):
DB_CONNECTION=sqlite
# Supabase / PostgreSQL (recommended for staging & production):
# DB_CONNECTION=pgsql
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=your-database-password
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # true in production (HTTPS only)
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Persistent root for private uploads; leave empty locally. On App Service use /home/data/app so clean deploys keep files.
FILESYSTEM_LOCAL_ROOT=
QUEUE_CONNECTION=database     # run "php artisan queue:work" for e-mail notifications
CACHE_STORE=database
CACHE_PREFIX=

# --- Mail (verification e-mails and bookmark notifications) -----------------
MAIL_MAILER=log               # production: resend (set RESEND_KEY) or smtp / ses / postmark
RESEND_KEY=                   # from https://resend.com/api-keys; sending domain must be verified in Resend
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@aipolicytracker.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- Application ------------------------------------------------------------
# Comma-separated e-mail addresses allowed into the /backend admin area.
ADMIN_EMAILS=admin@example.com
# Used once by "php artisan db:seed" to create the first admin account.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional public links (leave blank to hide the menu/footer item).
SITE_LINK_AIRIS=
SITE_LINK_WHITEPAPER=
SITE_LINK_PRIVACY_POLICY=
SITE_LINK_TERMS_OF_USE=
# The project's official mailbox: About page, footer, structured data, security.txt
# and the API description. Defaults to bhaskar@aipolicytracker.org when unset.
CONTACT_EMAIL=bhaskar@aipolicytracker.org
# Comma-separated addresses shown on the About page. Defaults to CONTACT_EMAIL.
CONTACT_EMAILS=

# Optional Google Analytics 4 measurement ID (blank disables tracking).
GOOGLE_ANALYTICS_ID=
# Shared secret for the weekly digest trigger (or set it from the admin Settings page).
CRON_TOKEN=
# Upper bound for client-supplied page sizes on JSON endpoints.
MAX_PER_PAGE=100
# Proxies allowed to set X-Forwarded-* headers: comma-separated addresses or CIDR
# ranges, or * when the proxy in front already rewrites X-Forwarded-For from the
# address it resolved (the shipped nginx configurations do). Rate limits and the
# hashed addresses in the audit log are only as honest as this setting.
TRUSTED_PROXIES=*

# Address quality. Registration, the newsletter, profile address changes and the
# contact address on a contribution refuse temporary and disposable mailboxes.
# Work and personal addresses are equally accepted; see docs/modules/accounts.md.
# Set to false to stop enforcing without editing validation rules.
EMAIL_DOMAIN_ENFORCEMENT=true
# Look the domain up in DNS and refuse one with no mail route. Turn off on a host
# with no outbound DNS; the curated lists keep working.
EMAIL_CHECK_DELIVERABILITY=true
EMAIL_DOMAIN_CACHE_TTL=86400
# Resolved as a control before "no mail route" is believed, so a resolver outage
# cannot become a sign-up outage.
EMAIL_RESOLVER_CANARY=gmail.com

# --- Legal pages (/privacy and /terms) -------------------------------------
# The site serves its own privacy policy and terms. Set these two only to point
# at documents hosted elsewhere; left empty, the built-in pages are used.
SITE_LINK_PRIVACY_POLICY=
SITE_LINK_TERMS_OF_USE=
# The entity that operates the site and controls the personal data.
LEGAL_ENTITY_NAME="Dignep Group Pvt. Ltd."
LEGAL_ENTITY_URL=https://certifyi.ai
LEGAL_ENTITY_ADDRESS=
# Where a reader sends an access, correction or erasure request. Falls back to
# CONTACT_EMAILS, then to the public contribution form. SET THIS: a privacy
# policy without a named address for data requests is incomplete.
LEGAL_PRIVACY_EMAIL=bhaskar@aipolicytracker.org
# e.g. Nepal. The governing-law clause is omitted from the terms while this is
# empty, because naming the wrong courts is worse than naming none.
LEGAL_GOVERNING_LAW=
# Shown as "last updated" on both pages. Bump when the text changes.
LEGAL_EFFECTIVE_FROM=2026-09-18

# --- Social preview cards ---------------------------------------------------
# The image a platform shows when a page is shared, drawn per record. Off falls
# back to the static file in SITE_OG_IMAGE for every page.
SOCIAL_CARDS_ENABLED=true
# Drawing text needs a TrueType font. Debian-based images usually carry DejaVu,
# which is found automatically. Set these only if `php artisan social:doctor`
# reports no face on the host; without one, the static file is served instead.
SOCIAL_FONT_BOLD=
SOCIAL_FONT_REGULAR=
# Comma-separated origins allowed for CORS (blank = none).
CORS_ALLOWED_ORIGINS=

VITE_APP_NAME="${APP_NAME}"

# --- Public site, SEO and analytics (all optional) ---------------------------
SITE_NAME="AIPolicyTracker"
SITE_GITHUB_URL=https://github.com/8h45k4r/aipolicytracker
SITE_CERTIFYI_URL=https://certifyi.ai
SITE_NEWSLETTER_URL=
SITE_SOCIAL_PROFILES=
SITE_OG_IMAGE=/og-default.png
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
CLOUDFLARE_ANALYTICS_TOKEN=
ANALYTICS_REQUIRE_CONSENT=true

# --- Billing (Dodo Payments, merchant of record) ---------------------------
# Nothing is sold until checkout is on (Admin → Settings "Checkout", or BILLING_ENABLED=true). Keys and product ids
# are normally created and stored encrypted by Admin → Billing → "Provision webhook and products"; these are fallbacks.
BILLING_ENABLED=false
DODO_PAYMENTS_ENVIRONMENT=test_mode   # test_mode or live_mode
DODO_PAYMENTS_API_KEY=                # Developer → API keys
DODO_PAYMENTS_WEBHOOK_KEY=            # Webhooks → endpoint signing secret (whsec_…)
DODO_PRODUCT_PRO_MONTHLY=             # pdt_… id of the monthly subscription product
DODO_PRODUCT_PRO_YEARLY=              # pdt_… id of the annual subscription product
BILLING_ON_HOLD_GRACE_DAYS=7

# Social preview card. Replace public/og-default.png to change the image; keep these in step with it.
SITE_OG_IMAGE=/og-default.png
SITE_OG_IMAGE_WIDTH=1200
SITE_OG_IMAGE_HEIGHT=630
