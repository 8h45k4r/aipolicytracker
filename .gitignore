# Dependencies
/node_modules
/vendor

# Build output & generated files
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/app/public/*
!/storage/app/public/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/.phpunit.cache
.phpunit.result.cache

# Environment & secrets
.env
.env.*
!.env.example
auth.json
*.pem
*.key

# Databases & exports
*.sqlite
*.sqlite3
*.sql
*.dump
/database/*.sqlite*

# Logs
/storage/logs/*
!/storage/logs/.gitignore
npm-debug.log*
yarn-error.log*

# Editors / OS
/.idea
/.vscode
/.fleet
.phpactor.json
.DS_Store
Thumbs.db

# Local tooling
Homestead.json
Homestead.yaml
