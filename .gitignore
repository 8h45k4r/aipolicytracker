# Dependencies
/node_modules
/vendor

# Build output & generated files
# /public/build is deliberately NOT ignored: the production host does not build
# assets. A Vite build needs Node plus roughly 200 MB of node_modules, which is
# most of the memory budget on the host this site shares with another
# application. deploy/deploy.sh therefore serves the build that arrives in the
# ref, and stops rather than serve a site with no stylesheet.
/public/hot
/public/storage
/storage/*.key
/storage/app/public/*
!/storage/app/public/.gitignore
# Operator overlay of throwaway e-mail domains, written by `email:domains-refresh`.
# Deliberately untracked: it is somebody else's list under somebody else's licence.
/storage/app/email/
# Rendered social preview cards. Generated on demand and keyed by content, so
# they are disposable: deleting them costs one redraw.
/storage/app/social-cards/
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/.phpunit.cache
.phpunit.result.cache

# Environment & secrets
.env
.env.*
!.env.example
auth.json
*.pem
*.key

# Databases & exports
*.sqlite
*.sqlite3
*.sql
*.dump
/database/*.sqlite*

# Logs
/storage/logs/*
!/storage/logs/.gitignore
npm-debug.log*
yarn-error.log*

# Editors / OS
/.idea
/.vscode
/.fleet
.phpactor.json
.DS_Store
Thumbs.db

# Local tooling
Homestead.json
Homestead.yaml

# Local notes for editor and assistant tooling; not part of the project.
CLAUDE.md
AGENTS.md
.claude/

# Scratch copies of the tree taken while reworking a module. They are whole
# duplicates of the project, so a stray `git add .` would commit a second copy
# of everything; name them here rather than rely on remembering.
/aipt-rewrite/
