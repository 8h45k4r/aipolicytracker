# Dependencies
/node_modules
/vendor

# Build output & generated files
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/app/public/*
!/storage/app/public/.gitignore
# Operator overlay of throwaway e-mail domains, written by `email:domains-refresh`.
# Deliberately untracked: it is somebody else's list under somebody else's licence.
/storage/app/email/
# Rendered social preview cards. Generated on demand and keyed by content, so
# they are disposable: deleting them costs one redraw.
/storage/app/social-cards/
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/.phpunit.cache
.phpunit.result.cache

# Environment & secrets
.env
.env.*
!.env.example
auth.json
*.pem
*.key

# Databases & exports
*.sqlite
*.sqlite3
*.sql
*.dump
/database/*.sqlite*

# Logs
/storage/logs/*
!/storage/logs/.gitignore
npm-debug.log*
yarn-error.log*

# Editors / OS
/.idea
/.vscode
/.fleet
.phpactor.json
.DS_Store
Thumbs.db

# Local tooling
Homestead.json
Homestead.yaml
