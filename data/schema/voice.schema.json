{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipolicytracker.org/schema/voice.schema.json",
  "title": "AI Voices profile",
  "description": "A person who holds, or held, a public office or formal role that shapes AI policy, safety or governance. People are chosen by role, not ranked. A profile carries only what an official source states about the role: no photo, no date of birth, no private details. Every profile is pending review until a published reviewer confirms it against its sources. One file per person in data/voices/, named after the slug.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slug": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "role": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "description": "The office or formal role, as the official source names it."
    },
    "organisation": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "jurisdiction": {
      "$ref": "common.schema.json#/$defs/slug",
      "description": "Jurisdiction slug from data/jurisdictions, or 'international' for an intergovernmental or standards body."
    },
    "category": {
      "type": "string",
      "enum": [
        "regulator",
        "government",
        "legislator",
        "standards",
        "international",
        "safety_institute",
        "judiciary"
      ],
      "description": "regulator: heads an authority that supervises or enforces AI rules. government: minister or senior official responsible for AI policy. legislator: sponsor or rapporteur of an AI law. standards: chairs or convenes an AI standards body. international: leads AI work at an intergovernmental body. safety_institute: leads a public AI safety or security institute."
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "policy",
          "safety",
          "governance",
          "responsible_ai",
          "strategy",
          "risk",
          "incidents",
          "standards",
          "regulation"
        ]
      },
      "minItems": 1
    },
    "current": {
      "type": "boolean",
      "description": "Holds the role as of last_checked_at, according to the official source."
    },
    "since": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ],
      "description": "When the role began, only if the official source states it."
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 900,
      "description": "In our own words: what the role does for AI policy and what the official sources say this person did in it. No opinion, no praise."
    },
    "related_policies": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/slug"
      },
      "description": "Policy slugs on record that this person sponsored, leads or enforces. Validated against data/policies."
    },
    "statements": {
      "type": "array",
      "description": "Public statements, speeches or publications in the role, each on an official page.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "date": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/date"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "publisher": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "title",
          "url",
          "publisher"
        ]
      }
    },
    "official_profile_url": {
      "$ref": "common.schema.json#/$defs/url",
      "description": "The official page that states the person holds the role."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "publisher": {
            "type": "string",
            "maxLength": 200
          },
          "url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "accessed": {
            "$ref": "common.schema.json#/$defs/date"
          }
        },
        "required": [
          "title",
          "publisher",
          "url",
          "accessed"
        ]
      }
    },
    "published": {
      "type": "boolean"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "verified"
      ]
    },
    "reviewed_by": {
      "$ref": "common.schema.json#/$defs/nullableString"
    },
    "last_verified_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_checked_at": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "confidence_level": {
      "$ref": "common.schema.json#/$defs/confidenceLevel"
    },
    "photo": {
      "description": "An openly licensed photo (CC0, public domain, CC BY or CC BY-SA) from Wikimedia Commons, linked from the person's Wikidata item, with its author and licence. Stored under public/images/voices.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "source_url",
        "license",
        "author",
        "wikidata"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.(jpg|png)$"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://commons\\.wikimedia\\.org/"
        },
        "license": {
          "type": "string",
          "pattern": "^(CC0|Public domain|PD|CC BY)"
        },
        "license_url": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "author": {
          "type": "string"
        },
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        }
      }
    }
  },
  "required": [
    "slug",
    "name",
    "role",
    "organisation",
    "jurisdiction",
    "category",
    "topics",
    "current",
    "summary",
    "official_profile_url",
    "sources",
    "published",
    "review_status",
    "last_checked_at",
    "confidence_level"
  ]
}
