{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipolicytracker.org/schema/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "nullableDate": {
      "anyOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "policyStatus": {
      "type": "string",
      "enum": [
        "proposed",
        "under_consultation",
        "adopted",
        "in_force",
        "partially_applicable",
        "guidance",
        "voluntary_standard",
        "enforcement_action",
        "superseded",
        "repealed",
        "archived"
      ]
    },
    "instrumentType": {
      "type": "string",
      "enum": [
        "act",
        "regulation",
        "directive",
        "bill",
        "executive_order",
        "rules",
        "strategy",
        "policy",
        "framework",
        "guidance",
        "standard",
        "code_of_practice",
        "consultation",
        "procurement_rule",
        "enforcement_decision"
      ]
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "verified",
        "needs_update"
      ]
    },
    "confidenceLevel": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unavailable"
      ]
    },
    "impactLevel": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "routine"
      ]
    },
    "sourceTier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "datePrecision": {
      "type": "string",
      "enum": [
        "exact",
        "month",
        "year",
        "tbd"
      ]
    },
    "sourceQuality": {
      "type": "object",
      "properties": {
        "official_source_url": {
          "$ref": "#/$defs/url"
        },
        "source_title": {
          "type": "string",
          "minLength": 3
        },
        "source_publisher": {
          "type": "string",
          "minLength": 2
        },
        "source_document_date": {
          "$ref": "#/$defs/nullableDate"
        },
        "source_reference": {
          "$ref": "#/$defs/nullableString"
        },
        "source_tier": {
          "$ref": "#/$defs/sourceTier"
        },
        "last_checked_at": {
          "$ref": "#/$defs/nullableDate"
        },
        "last_verified_at": {
          "$ref": "#/$defs/nullableDate"
        },
        "review_status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "confidence_level": {
          "$ref": "#/$defs/confidenceLevel"
        },
        "content_version": {
          "type": "integer",
          "minimum": 1
        },
        "change_summary": {
          "$ref": "#/$defs/nullableString"
        },
        "reviewed_by": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "required": [
        "official_source_url",
        "source_title",
        "source_publisher",
        "review_status",
        "confidence_level",
        "content_version"
      ]
    },
    "sourceDocument": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "document_date": {
          "$ref": "#/$defs/nullableDate"
        },
        "document_type": {
          "type": "string",
          "enum": [
            "legislation",
            "guidance",
            "consultation",
            "press_release",
            "standard",
            "strategy",
            "enforcement",
            "secondary",
            "official"
          ]
        },
        "tier": {
          "$ref": "#/$defs/sourceTier"
        },
        "language": {
          "type": "string"
        },
        "license_note": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "required": [
        "title",
        "url",
        "publisher",
        "tier"
      ]
    },
    "faqItem": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 8
        },
        "answer": {
          "type": "string",
          "minLength": 20
        }
      },
      "required": [
        "question",
        "answer"
      ]
    },
    "termSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
      "maxLength": 64
    }
  }
}
