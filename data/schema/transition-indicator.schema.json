{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipolicytracker.org/schema/transition-indicator.schema.json",
  "title": "AI economic transition indicator",
  "description": "A time series about AI-driven economic change (announced AI-attributed layoffs, retraining enrolments, fund balances), each point cited. A series with no points is a definition awaiting data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "unit", "review_status"],
  "properties": {
    "slug": { "$ref": "common.schema.json#/$defs/slug" },
    "title": { "type": "string", "minLength": 5 },
    "jurisdiction": { "$ref": "common.schema.json#/$defs/nullableString" },
    "unit": { "type": "string", "minLength": 1 },
    "description": { "$ref": "common.schema.json#/$defs/nullableString" },
    "frequency": { "type": "string", "enum": ["monthly", "quarterly", "annual", "irregular"] },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["period", "value", "source_url"],
        "properties": {
          "period": { "type": "string", "pattern": "^[0-9]{4}(-Q[1-4]|-[0-9]{2})?$" },
          "value": { "type": "number" },
          "source_url": { "$ref": "common.schema.json#/$defs/url" },
          "source_title": { "$ref": "common.schema.json#/$defs/nullableString" },
          "note": { "$ref": "common.schema.json#/$defs/nullableString" }
        }
      }
    },
    "official_source_url": { "$ref": "common.schema.json#/$defs/nullableString" },
    "source_publisher": { "$ref": "common.schema.json#/$defs/nullableString" },
    "source_tier": { "$ref": "common.schema.json#/$defs/sourceTier" },
    "last_checked_at": { "$ref": "common.schema.json#/$defs/nullableDate" },
    "last_verified_at": { "$ref": "common.schema.json#/$defs/nullableDate" },
    "review_status": { "$ref": "common.schema.json#/$defs/reviewStatus" },
    "confidence_level": { "$ref": "common.schema.json#/$defs/confidenceLevel" },
    "reviewed_by": { "$ref": "common.schema.json#/$defs/nullableString" },
    "published": { "type": "boolean" }
  }
}
